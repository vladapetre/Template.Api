{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "ApplicationName": "Template.Host"
    }
  },
  "AllowedHosts": "*",
  "PersistenceConfiguration": {
    "ConnectionStrings": {
      "DatabaseDbContext": "Data Source=../../template.db",
      "RabbitMQ": "rabbitmq://guest:guest@localhost"
    }
  },
  "OutboxConfiguration": {
    "ConnectionStrings": {
      "OutboxDbContext": "Data Source=../../template.db",
      "RabbitMQ": "rabbitmq://guest:guest@localhost"
    }
  }
}
