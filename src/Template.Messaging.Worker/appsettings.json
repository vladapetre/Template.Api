{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "ApplicationName": "Template.Messaging.Worker"
    }
  },
  "ConnectionStrings":{
    "Database": "Server=localhost;Database=template;User Id=sa;Password=Passw0rd;Trusted_Connection=False;"
  },
  "OutboxConfiguration": {
    "ConnectionStrings": {
      "RabbitMQ": "rabbitmq://guest:guest@localhost"
    }
  }
}
